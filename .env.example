# Local Supabase (values printed by `npx supabase status`). These are the public local-dev defaults.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# AI (server only). Either can be left empty: the classifier then falls back to
# Claude only, or to the built-in keyword rules, so the demo still runs.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# Set to "true" to send photo/video frames to Jev (experimental image preview, architecture §5.4).
JEV_IMAGES=true

# Links in emails and technician pages.
APP_URL=http://localhost:3000
# Email (optional). Without a key, emails are only logged and shown in the demo panel's outbox.
RESEND_API_KEY=
EMAIL_FROM=Fixa <onboarding@resend.dev>
# Shared secret for /api/cron/reminders (Supabase Cron sends it as a Bearer token).
CRON_SECRET=change-me
# Demo mode: the sensor demo panel (/demo) and one-tap test accounts on the sign-in page.
# On in development; set to "true" to show them in production (e.g. while testing on Vercel).
DEMO_PANEL=
# Sign-up creates accounts already confirmed. Set to "true" to require the confirmation email
# instead (needs working email on the Supabase project).
REQUIRE_EMAIL_CONFIRMATION=
